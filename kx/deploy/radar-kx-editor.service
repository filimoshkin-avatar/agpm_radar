[Unit]
Description=Radar KX editor review queue (loopback only)
Documentation=file:///opt/radar-kx/current/README.md
After=postgresql.service
Requires=postgresql.service
ConditionPathExists=/etc/radar-kx/editor.env

[Service]
# Slice 2.12. The process binds to loopback and the unit refuses any other
# socket. What reaches it from outside is Caddy, at radar.agpm.space/po, behind
# HTTP basic auth — the owner asked for that on 2026-08-23 so they can read and
# approve from a browser, and P21 anticipated an editor mode on the public domain
# behind a login.
#
# The database still has no public port, no route and no DNS record: what is
# published is an authenticated application, which is what ADR-0005 §16 calls the
# editor/research API. The service checks the credentials again itself, because a
# service that trusts a proxy is open the moment somebody reaches it another way.
#
# It is also still reachable straight through a tunnel:
#   ssh -N -L 19702:127.0.0.1:19702 root@<host>
Type=exec
User=radar_kx
Group=radar_kx
WorkingDirectory=/opt/radar-kx/current
EnvironmentFile=/etc/radar-kx/worker.env
EnvironmentFile=/etc/radar-kx/editor.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/radar-kx/current/src
Environment=XDG_CACHE_HOME=/tmp/radar-kx-cache
ExecStart=/opt/radar-kx/runtime/current/bin/python -m radar_kx editor \
    --host 127.0.0.1 --port 19702 --actor ${RADAR_KX_EDITOR_ACTOR}
Restart=on-failure
RestartSec=5s
UMask=0077

# It reads full text out of KX and talks to nothing else.
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:19702

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateIPC=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

ReadOnlyPaths=/opt/radar-kx /etc/radar-kx
ReadWritePaths=/var/run/postgresql
InaccessiblePaths=/var/lib/radar-hermes /var/lib/nrd /etc/nrd /srv

[Install]
WantedBy=multi-user.target
