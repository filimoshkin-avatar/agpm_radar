[Unit]
Description=Radar KX self-contained PostgreSQL backup
After=postgresql.service radar-kx-ingest.service
Requires=postgresql.service

[Service]
Type=oneshot
User=radar_kx
Group=radar_kx
WorkingDirectory=/opt/radar-kx/current
EnvironmentFile=/etc/radar-kx/worker.env
ExecStart=/opt/radar-kx/current/deploy/radar-kx-backup
UMask=0077
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=1G
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/radar-kx
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
