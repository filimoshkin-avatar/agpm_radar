[Unit]
Description=Radar KX egress proxy (CONNECT to the two approved model endpoints only)
Documentation=file:///opt/radar-kx/current/README.md
Wants=network-online.target
After=network-online.target
Before=radar-kx-hermes-extraction.service
ConditionPathIsDirectory=/opt/radar-kx/current
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=exec
User=radar-kx-egress
Group=radar-kx-egress
Environment=PYTHONPATH=/opt/radar-kx/current/src
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/radar-kx/runtime/current/bin/python -m radar_kx.egress_proxy --host 127.0.0.1 --port 19701
Restart=on-failure
RestartSec=5s
TimeoutStartSec=20s
TimeoutStopSec=20s
KillSignal=SIGTERM
KillMode=mixed
UMask=0077

RuntimeDirectory=radar-kx-egress
RuntimeDirectoryMode=0700

# This unit is the one KX process that may leave the host; the allowlist it applies
# is in radar_kx/egress_proxy.py, under the repository gates. Everything else about
# it is closed: no filesystem it can write, no privilege it can gain, no capability.
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateIPC=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

ReadOnlyPaths=/opt/radar-kx
InaccessiblePaths=/etc/radar-kx /var/lib/postgresql /srv
NoExecPaths=/run/radar-kx-egress
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:19701

[Install]
WantedBy=multi-user.target
