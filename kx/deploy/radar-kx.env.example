# Installed as /etc/radar-kx/worker.env on the Local Ru production host.
RADAR_KX_DSN=dbname=radar_kx user=radar_kx host=/var/run/postgresql
RADAR_KX_CAPACITY_PATH=/var/lib/postgresql
RADAR_KX_USER_AGENT=Radar-KX/1.0 (+https://radar.agpm.space)
RADAR_KX_REQUEST_TIMEOUT_SECONDS=30
RADAR_KX_CONNECT_TIMEOUT_SECONDS=10
RADAR_KX_PER_HOST_INTERVAL_SECONDS=1
RADAR_KX_MAX_BODY_BYTES=15728640
RADAR_KX_MIN_TEXT_CHARS=200
RADAR_KX_MIN_FREE_BYTES=21474836480
RADAR_KX_LEASE_SECONDS=300
RADAR_KX_MAX_ATTEMPTS=4
RADAR_KX_MAX_IN_FLIGHT_PER_HOST=8
RADAR_KX_RESPECT_ROBOTS=true
