{
  "$id": "https://radar.aipractice.space/contracts/v1/project-manager-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "publicationStatus": {
            "enum": [
              "published",
              "already_succeeded"
            ]
          }
        },
        "required": [
          "publicationStatus"
        ]
      },
      "then": {
        "properties": {
          "errorCode": {
            "type": "null"
          },
          "publicationSucceeded": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publicationStatus": {
            "enum": [
              "rejected",
              "failed",
              "rolled_back",
              "needs_reconciliation"
            ]
          }
        },
        "required": [
          "publicationStatus"
        ]
      },
      "then": {
        "properties": {
          "errorCode": {
            "type": "string"
          },
          "nextAction": {
            "type": "string"
          },
          "publicationSucceeded": {
            "const": false
          }
        }
      }
    }
  ],
  "properties": {
    "candidateId": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{7,127}$",
      "type": "string"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "deliveryRequired": {
      "const": true
    },
    "errorCode": {
      "pattern": "^[A-Z0-9_]{3,80}$",
      "type": [
        "string",
        "null"
      ]
    },
    "issueDate": {
      "format": "date",
      "type": [
        "string",
        "null"
      ]
    },
    "llmOutcome": {
      "$ref": "llm-outcome.schema.json"
    },
    "nextAction": {
      "maxLength": 2000,
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "enum": [
        "daily",
        "correction",
        "gazette"
      ]
    },
    "publicationStatus": {
      "enum": [
        "published",
        "already_succeeded",
        "rejected",
        "failed",
        "rolled_back",
        "needs_reconciliation"
      ]
    },
    "publicationSucceeded": {
      "type": "boolean"
    },
    "publisherResultSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "releaseId": {
      "maxLength": 128,
      "minLength": 8,
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "maxLength": 4000,
      "minLength": 10,
      "type": "string"
    },
    "warnings": {
      "items": {
        "maxLength": 2000,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "contractVersion",
    "candidateId",
    "operation",
    "publicationStatus",
    "publicationSucceeded",
    "summary",
    "llmOutcome",
    "warnings",
    "errorCode",
    "nextAction",
    "publisherResultSha256",
    "deliveryRequired"
  ],
  "title": "Project Manager final Radar report",
  "type": "object"
}
